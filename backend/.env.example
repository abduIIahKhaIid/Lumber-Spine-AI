# Copy to backend/.env and fill in. Never commit the real .env.

# --- AI assistant providers (any subset) ------------------------------------------------
# Answers try providers in LLM_FALLBACK_ORDER. A rate limit, timeout or error moves the
# request to the next provider/model automatically.
LLM_FALLBACK_ORDER=groq,gemini,ollama
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Local Ollama, or an HTTPS tunnel (e.g. Colab). Leave empty to disable.
OLLAMA_BASE_URL=
OLLAMA_MODELS=gemma3:4b
OLLAMA_API_KEY=
# Messages with an image go to vision-capable models, in this order.
LLM_VISION_ORDER=gemini,groq,ollama
GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TIMEOUT_SECONDS=90

# --- Background jobs ----------------------------------------------------------------------
# auto: Celery when Redis answers at REDIS_URL, otherwise an in-process queue.
JOB_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
# Load every model when a worker starts (1) or on first use (0).
WORKER_PRELOAD_MODELS=1

# --- Paths and limits ---------------------------------------------------------------------
MODEL_DIR=model
DATA_DIR=data
MAX_UPLOAD_MB=120
RATE_LIMIT_PER_MINUTE=30
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Case library (local single reviewer) -----------------------------------------------
# Use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_ACCESS_TOKEN=
REVIEWER_NAME=

# Optional: approved evaluation artifact produced by tools/evaluate.py
CALIBRATION_FILE=
